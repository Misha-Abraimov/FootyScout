APP_NAME=FootyScout API
APP_ENV=development
DATABASE_URL=postgresql+psycopg://scoutlens:scoutlens_dev@localhost:5433/scoutlens
CORS_ORIGINS=["http://localhost:3000"]
AI_SCOUT_PROVIDER=anthropic
AI_SCOUT_FALLBACK_PROVIDER=
ANTHROPIC_API_KEY=
AI_SCOUT_ANTHROPIC_MODEL=claude-sonnet-5
AI_SCOUT_ANTHROPIC_TIMEOUT_SECONDS=

# Optional alternative provider
OPENAI_API_KEY=
AI_SCOUT_OPENAI_MODEL=gpt-5-mini
AI_SCOUT_OPENAI_TIMEOUT_SECONDS=20
AI_SCOUT_OPENAI_PLANNER_REASONING_EFFORT=low
AI_SCOUT_SYNTHESIS_MODEL=gpt-5-mini
AI_SCOUT_SYNTHESIS_TIMEOUT_SECONDS=30
AI_SCOUT_MAX_RETRIES=1
# Keep strict for local evaluation/regression; set balanced in production deployment.
AI_SCOUT_VALIDATION_MODE=strict
AI_SCOUT_WEB_SEARCH_ENABLED=false
AI_SCOUT_WEB_SEARCH_PROVIDER=exa
EXA_API_KEY=
AI_SCOUT_WEB_MAX_RESULTS=5
AI_SCOUT_WEB_TIMEOUT_SECONDS=15
AI_SCOUT_WEB_MAX_RETRIES=1
AI_SCOUT_MAX_OUTPUT_TOKENS=4096
AI_SCOUT_WEB_CONTENT_MAX_AGE_HOURS=24
AI_SCOUT_WEB_CURRENT_STATUS_MAX_AGE_HOURS=168
AI_SCOUT_TRACE_ENABLED=false
AI_SCOUT_TRACE_PATH=
AI_SCOUT_PRICING_REGISTRY_PATH=
LANGSMITH_TRACING_ENABLED=false
LANGSMITH_PROJECT=footyscout-ai-scout
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=
OTEL_ENABLED=false
OTEL_SERVICE_NAME=footyscout-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
AI_SCOUT_JUDGE_ENABLED=false
AI_SCOUT_JUDGE_PROVIDER=openai
AI_SCOUT_JUDGE_MODEL=
AI_SCOUT_JUDGE_TIMEOUT_SECONDS=30
AI_SCOUT_JUDGE_MAX_RETRIES=1
